# PostHog project API key (required to enable tracking)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog ingestion host - use your region's endpoint
# US: https://us.i.posthog.com
# EU: https://eu.i.posthog.com
# Self-hosted: https://your-posthog-instance.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
